# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes to git.

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Spring Boot loads backend/.env automatically. Use exactly one value for each
# variable. Never define SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME, or
# SPRING_DATASOURCE_PASSWORD alongside the DB_* variables below.
#
# Local PostgreSQL defaults:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maamora_studio
DB_USERNAME=maamora
DB_PASSWORD=maamora
DB_SSL_MODE=disable
#
# Supabase shared Session pooler example (replace every placeholder locally):
# DB_HOST=aws-[region].pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.[project-ref]
# DB_PASSWORD=your-current-supabase-database-password
# DB_SSL_MODE=require
#
# Copy the Session pooler connection string from Supabase Dashboard → Connect.
# The database password is not an anon, publishable, service, or secret API key.

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Create a Google Cloud OAuth client of type Web application.
# Register this exact local redirect URI in Google Cloud Console:
# http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── CORS ────────────────────────────────────────────────────────────────────
# Must match the frontend origin(s) used by the browser. The wildcard forms
# keep local Next.js port changes (3000, 3001, 3002, ...) from becoming CORS
# failures. Use explicit deployed origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
FRONTEND_URL=http://localhost:3001

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# ── AI APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# A4F OpenAI-compatible product visual generation. A4F uses Bearer authentication.
# Text-to-image uses A4F_IMAGE_MODEL; a single product reference uses A4F_EDIT_MODEL via /images/edits.
# Model IDs must include A4F's provider prefix. The free plan is rate-limited and not unlimited.
# To use A4F, set IMAGE_PROVIDER=a4f and provide A4F_API_KEY.
# A4F_API_KEY=your-a4f-api-key
# A4F_IMAGE_MODEL=provider-2/flux.1-schnell
# A4F_EDIT_MODEL=provider-3/flux-kontext-pro
# A4F_BASE_URL=https://api.a4f.co/v1
# A4F_RESPONSE_FORMAT=b64_json
# A4F_TIMEOUT_MS=120000

# Hugging Face Inference Providers image-generation fallback.
# Uses limited monthly credits; it is not unlimited free capacity.
# Keep the token backend-only. The current adapter supports text-to-image;
# reference-image editing remains explicitly unavailable on this route.
# To use it, set IMAGE_PROVIDER=huggingface and provide HUGGINGFACE_API_KEY.
# HUGGINGFACE_API_KEY=hf_your-token
# HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models
# HUGGINGFACE_TIMEOUT_MS=180000

# Managed image generation through ApiFrame. ApiFrame uses one X-API-Key for multiple hosted image models.
# flux-2-pro supports up to eight references; seedream-5-pro supports up to ten; nano-banana supports up to fourteen.
# ApiFrame is pay-as-you-go with starter credits, not unlimited free usage. Results are CDN-hosted for 90 days, so STUDIO downloads them into configured storage.
# To use it, set IMAGE_PROVIDER=apiframe and provide APIFRAME_API_KEY.
# APIFRAME_API_KEY=afk_your_api_key
# APIFRAME_IMAGE_MODEL=flux-2-pro
# APIFRAME_BASE_URL=https://api.apiframe.ai/v2
# APIFRAME_POLL_INTERVAL_MS=3000
# APIFRAME_TIMEOUT_MS=180000
# APIFRAME_OUTPUT_FORMAT=png

# Optional legacy provider: Cloudflare Workers AI FLUX.2 [dev].
# Keep these variables only if you intentionally switch away from ApiFrame.
IMAGE_PROVIDER=a4f
IMAGE_PROVIDER_FALLBACK=apiframe
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_AI_TIMEOUT_MS=180000
CLOUDFLARE_AI_POLL_INTERVAL_MS=3000
CLOUDFLARE_AI_RETRY_ATTEMPTS=3
CLOUDFLARE_AI_RETRY_BACKOFF_MS=1500
CLOUDFLARE_AI_STEPS=25
CLOUDFLARE_AI_GUIDANCE=4.0

# Managed image generation through deAPI's native asynchronous v2 API.
# Image jobs return a request ID and are polled until the result URL is ready.
# Product-plus-model shoots use the v2 edits endpoint with images[].
# To switch to DeAPI, replace IMAGE_PROVIDER=apiframe with IMAGE_PROVIDER=deapi.
# DEAPI_API_KEY=your-deapi-api-key
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_IMAGE_MODEL=Flux1schnell
DEAPI_EDIT_MODEL=QwenImageEdit_Plus_NF4
DEAPI_STEPS=4
DEAPI_GUIDANCE=7.5
DEAPI_POLL_INTERVAL_MS=3000
DEAPI_TIMEOUT_MS=180000

# Gemini caption generation. Use a separate caption key when video uses another key.
CAPTION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_CAPTION_API_KEY=your-gemini-caption-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Stability AI alternative. Select with IMAGE_PROVIDER=stability.
# STABILITY_API_KEY=your-stability-api-key
# STABILITY_IMAGE_MODEL=ultra
# STABILITY_BASE_URL=https://api.stability.ai
# STABILITY_TIMEOUT_MS=180000

# Optional fal.ai alternative. Select with IMAGE_PROVIDER=fal.
# FLUX.1 Kontext Pro also accepts one reference image per request.
# FAL_KEY=your-fal-key
# FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
# FAL_BASE_URL=https://fal.run
# FAL_TIMEOUT_MS=180000

# Optional Groq caption alternative. Select with CAPTION_PROVIDER=groq.
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter is retained only as an optional legacy caption/image provider.
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_ATTEMPTS=2

# Optional Gemini video generation. Keep the video key separate from captions.
# GEMINI_VIDEO_API_KEY=your-gemini-video-key
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# GEMINI_VIDEO_TIMEOUT_MS=600000
# GEMINI_VIDEO_POLL_INTERVAL_MS=5000

# Optional free local caption provider. Install Ollama, then run:
#   ollama pull qwen2.5:7b
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/api

# Optional legacy Higgsfield image generation. Keep both values server-side. Use IMAGE_PROVIDER=higgsfield only when this provider is intentionally selected.
# The endpoint below is the official v2 text-to-image example.
# HIGGSFIELD_API_KEY_ID=your-higgsfield-key-id
# HIGGSFIELD_API_KEY_SECRET=your-higgsfield-key-secret
# HIGGSFIELD_MODEL=flux-pro/kontext/max/text-to-image
# HIGGSFIELD_REFERENCE_MODEL=flux-pro/kontext/max/image-to-image
# HIGGSFIELD_VIDEO_MODEL=your-enabled-video-model
# HIGGSFIELD_TIMEOUT_MS=180000
# HIGGSFIELD_POLL_INTERVAL_MS=3000

# Legacy custom Cloudflare Worker integration; not used by IMAGE_PROVIDER=cloudflare.
# CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev/
# CLOUDFLARE_API_KEY=your-custom-worker-key

# ── Cloudinary (image storage) ──────────────────────────────────────────────
# Get these from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── SMTP email delivery ─────────────────────────────────────────────────────
# Spring's standard variable names are preferred. SMTP_* aliases are also
# accepted for older local environments. APP_MAIL_FROM is required to queue
# real messages; an absent sender produces an explicit FAILED delivery record.
# For MailerSend SMTP, use smtp.mailersend.net, port 587, your MailerSend SMTP
# username, and the SMTP password/token shown in the MailerSend SMTP setup page.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-smtp-user
# SPRING_MAIL_PASSWORD=your-smtp-password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# APP_MAIL_FROM=studio@example.com

# ── Social OAuth and encrypted token storage ────────────────────────────────
# Register these exact callback URLs in each provider application.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8080/api/social/callback/meta
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:8080/api/social/callback/tiktok
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8080/api/social/callback/linkedin
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:8080/api/social/callback/x
# TOKEN_CIPHER_KEY=replace-with-exactly-32-random-characters
