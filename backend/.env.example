# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example goes to git.

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# For a shared/hosted DB (e.g. Supabase, Neon): use the host/port/db/user/
# password from your provider's connection info, and set DB_SSL_MODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maamora_studio
DB_USERNAME=maamora
DB_PASSWORD=maamora
DB_SSL_MODE=disable

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ── CORS ────────────────────────────────────────────────────────────────────
# Must match the frontend origin(s) used by the browser. The wildcard forms
# keep local Next.js port changes (3000, 3001, 3002, ...) from becoming CORS
# failures. Use explicit deployed origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# ── AI APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=your-gemini-key

# Optional free local caption provider. Install Ollama, then run:
#   ollama pull qwen2.5:7b
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/api

# Optional Higgsfield image generation. Keep both values server-side.
# The endpoint below is the official v2 text-to-image example.
# HIGGSFIELD_API_KEY_ID=your-higgsfield-key-id
# HIGGSFIELD_API_KEY_SECRET=your-higgsfield-key-secret
# HIGGSFIELD_MODEL=flux-pro/kontext/max/text-to-image
# HIGGSFIELD_TIMEOUT_MS=180000
# HIGGSFIELD_POLL_INTERVAL_MS=3000

CLOUDFLARE_WORKER_URL=https://image-api.mouadebra.workers.dev/
CLOUDFLARE_API_KEY=your-cloudflare-key

# ── Cloudinary (image storage) ──────────────────────────────────────────────
# Get these from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
